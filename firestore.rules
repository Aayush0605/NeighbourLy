rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // System probe path for connection testing
    match /system/{docId} {
      allow read, write: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow read, write: if true;

      match /private/{docId} {
        allow read, write: if true;
      }
    }

    // Service Listings
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isValidId(serviceId) &&
        incoming().id == serviceId &&
        incoming().title is string &&
        incoming().title.size() >= 3 &&
        incoming().title.size() <= 150 &&
        incoming().description is string &&
        incoming().category is string &&
        incoming().price is number &&
        incoming().price > 0 &&
        incoming().price <= 100000;
      allow update, delete: if true;
    }

    // Service Requests
    match /requests/{requestId} {
      allow read: if true;
      allow create: if isValidId(requestId) &&
        incoming().id == requestId &&
        incoming().title is string &&
        incoming().title.size() >= 3 &&
        incoming().title.size() <= 150 &&
        incoming().description is string &&
        incoming().budget is number &&
        incoming().budget > 0 &&
        incoming().budget <= 100000;
      allow update, delete: if true;
    }

    // Escrow Orders
    match /orders/{orderId} {
      allow read, write: if true;

      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Real-time Conversations & Messaging across different IDs
    match /conversations/{conversationId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Real-time In-App Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read, write: if true;
    }
  }
}
